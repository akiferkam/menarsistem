# Faz 1 (CLI): tek yayınevi / tek kullanıcı varsayımıyla global anahtarlar.
# Faz 3+'ta bunlar publisher_api_key tablosundan per-yayınevi çözülür;
# bu dosya yalnız yerel geliştirme / CLI smoke-test içindir.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Her aşama için model kimliği — kodda asla sabitlenmez (bkz. packages/core/config.ts).
MODEL_GENERATOR=gpt-6-astra
MODEL_SOLVER_A=claude-sonnet-5
MODEL_SOLVER_B=gpt-5.1
MODEL_BOARD=gpt-5.1
MODEL_CONTEXT_IMAGE_PROMPT=gpt-5.6-sol
MODEL_IMAGE=gpt-image-1
# AŞAMA 2 görsel denetimi — sağlayıcı kodda sabit anthropic'tir (bkz.
# apps/api/lib/provider-deps.ts), burada yalnız model adı değişir.
MODEL_VISION_CHECK=claude-opus-5

# gorselKalitesi=YUKSEK işlerinde kullanılan görsel modeli (fal.ai) — genel varsayılan.
MODEL_IMAGE_HQ=fal-ai/flux-pro/v1.1-ultra
MODEL_IMAGE_HQ_EDIT=fal-ai/flux-pro/kontext

# Ders bazlı override — tanımlanan ders için yukarıdaki genel MODEL_IMAGE_HQ yerine
# geçer (STANDART üretim modu bundan HİÇBİR ZAMAN etkilenmez, hep gpt-image-1 kullanır).
# Tümü opsiyonel; boş bırakılan ders genel MODEL_IMAGE_HQ'ya düşer. Değer, fal.ai'nin
# barındırdığı HERHANGİ bir model id'si olabilir (Flux, Ideogram, Nano Banana, ...).
# NOT: Nano Banana Pro'nun girdi şeması (image_urls dizisi, aspect_ratio/resolution)
# diğer modellerden (image_url tekil, image_size, strength) FARKLI — `llm/fal.ts`
# `isNanoBanana()` bunu model id'sinden ("nano-banana" geçiyor mu) otomatik algılar,
# yeni bir farklı-şemalı model eklerseniz orada da eşleştirme gerekebilir.
# MODEL_IMAGE_HQ_MATEMATIK=fal-ai/nano-banana-pro
# MODEL_IMAGE_HQ_EDIT_MATEMATIK=fal-ai/nano-banana-pro/edit
# MODEL_IMAGE_HQ_FIZIK=ideogram/v4
# MODEL_IMAGE_HQ_EDIT_FIZIK=ideogram/v4/image-to-image
# MODEL_IMAGE_HQ_KIMYA=fal-ai/nano-banana-pro
# MODEL_IMAGE_HQ_EDIT_KIMYA=fal-ai/nano-banana-pro/edit
# MODEL_IMAGE_HQ_BIYOLOJI=fal-ai/nano-banana-pro
# MODEL_IMAGE_HQ_EDIT_BIYOLOJI=fal-ai/nano-banana-pro/edit
# MODEL_IMAGE_HQ_GEOMETRI=fal-ai/flux-pro/v1.1-ultra
# MODEL_IMAGE_HQ_TDE=fal-ai/flux-pro/v1.1-ultra

# full  = MASTER_CORE/V20/V20.2/V21 blokları birebir gönderilir (brief Bölüm 1 mandatı)
# compact = node 04'ün üretimde doğrulanmış 20 kural listesi gönderilir (varsayılan)
PROMPT_MODE=compact

# gerçek LLM çağrısı yapmadan pipeline'ı doğrulamak için (testlerde kullanılır)
LLM_PROVIDER_MODE=live

# --- Faz 3 (apps/api): çok-kiracılı, BYOK ---
# Admin uçlarını (POST /yayinevi, POST /ogretmen) korur — rastgele üretin.
API_ADMIN_TOKEN=
# publisher_api_key'deki BYOK anahtarlarını AES-256-GCM ile şifreler — rastgele üretin, kaybederseniz kayıtlı anahtarlar çözülemez.
API_KEY_ENCRYPTION_SECRET=
API_PORT=4000
API_HOST=127.0.0.1
# Section 13 #2 (20+ eş zamanlı öğretmen/yayınevi) — bkz. apps/api/queue/worker.ts
API_GLOBAL_CONCURRENCY=8
API_PER_YAYINEVI_CONCURRENCY=3
API_QUEUE_POLL_MS=2000
MAYS_DB_PATH=
MAYS_API_OUTPUT_DIR=
